{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and role-based access control information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["super_admin", "approved_user", "basic_user", "admin"] },
        "status": { "type": "string", "enum": ["active", "pending"] },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "planExpiresAt": { "type": "string", "maxLength": 64 },
        "todayPosterCount": { "type": "number" },
        "lastPosterDate": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "userId", "email", "role", "status"]
    },
    "SavedDesign": {
      "title": "SavedDesign",
      "description": "Cloud-synced Islamic poster design project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "thumb": { "type": "string", "maxLength": 500000 },
        "poster": { "type": "object" },
        "created": { "type": "number" },
        "updated": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "poster"]
    },
    "PosterPreset": {
      "title": "PosterPreset",
      "description": "Custom reusable poster styling preset template",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 64 },
        "previewGradient": { "type": "string", "maxLength": 256 },
        "config": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "name", "config"]
    },
    "BrandSettings": {
      "title": "BrandSettings",
      "description": "User Islamic media brand settings and logo",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "tagline": { "type": "string", "maxLength": 256 },
        "handle": { "type": "string", "maxLength": 128 },
        "logo": { "type": "string", "maxLength": 500000 },
        "pos": { "type": "string", "maxLength": 32 },
        "logoSize": { "type": "number" },
        "showLogo": { "type": "boolean" },
        "showTag": { "type": "boolean" },
        "showHandle": { "type": "boolean" },
        "watermark": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "name", "handle"]
    },
    "UserFavorites": {
      "title": "UserFavorites",
      "description": "User bookmarked Quran and Hadith quotes",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "quoteIds": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "quoteIds"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Payment verification and account notifications for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["payment_approved", "payment_rejected", "info"] },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 600 },
        "requestId": { "type": "string", "maxLength": 128 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "type", "title", "message", "read", "createdAt"]
    },
    "PaymentUpgradeRequest": {
      "title": "PaymentUpgradeRequest",
      "description": "User bKash payment upgrade request submitted for 1-month Pro or Enterprise activation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 128 },
        "planId": { "type": "string", "enum": ["pro", "enterprise"] },
        "planName": { "type": "string", "maxLength": 128 },
        "targetPlan": { "type": "string", "enum": ["pro", "enterprise"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["BDT"] },
        "paymentMethod": { "type": "string", "enum": ["bkash"] },
        "receiverNumberAtSubmission": { "type": "string", "maxLength": 32 },
        "senderNumber": { "type": "string", "maxLength": 32 },
        "senderPhone": { "type": "string", "maxLength": 32 },
        "transactionId": { "type": "string", "maxLength": 64 },
        "screenshotUrl": { "type": "string", "maxLength": 1048576 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "reviewedBy": { "type": "string", "maxLength": 256 },
        "rejectionReason": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "userEmail", "targetPlan", "amount", "senderPhone", "transactionId", "status", "createdAt"]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "Dynamic bKash receiver number and manual payment configuration controlled by Super Admin",
      "type": "object",
      "properties": {
        "bkashNumber": { "type": "string", "maxLength": 32 },
        "paymentEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["bkashNumber", "paymentEnabled", "updatedAt", "updatedBy"]
    },
    "PaymentSettingsHistory": {
      "title": "PaymentSettingsHistory",
      "description": "Immutable audit log of bKash receiver number changes by Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "previousNumber": { "type": "string", "maxLength": 32 },
        "newNumber": { "type": "string", "maxLength": 32 },
        "changedBy": { "type": "string", "maxLength": 256 },
        "changedByName": { "type": "string", "maxLength": 128 },
        "changedByUid": { "type": "string", "maxLength": 128 },
        "changedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "previousNumber", "newNumber", "changedBy", "changedByUid", "changedAt"]
    },
    "UsedTransaction": {
      "title": "UsedTransaction",
      "description": "Atomic duplicate Transaction ID lock record",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "requestId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["transactionId", "userId", "requestId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    },
    "/users/{userId}/designs/{designId}": {
      "schema": "SavedDesign",
      "description": "User saved poster designs"
    },
    "/users/{userId}/presets/{presetId}": {
      "schema": "PosterPreset",
      "description": "User saved custom poster design presets"
    },
    "/users/{userId}/brand/{brandDoc}": {
      "schema": "BrandSettings",
      "description": "User brand configuration and logo"
    },
    "/users/{userId}/favorites/{favDoc}": {
      "schema": "UserFavorites",
      "description": "User bookmarked favorites"
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": "UserNotification",
      "description": "User payment approval and rejection notifications"
    },
    "/upgradeRequests/{requestId}": {
      "schema": "PaymentUpgradeRequest",
      "description": "Payment verification requests submitted by users"
    },
    "/settings/paymentSettings": {
      "schema": "PaymentSettings",
      "description": "Global active bKash payment configuration"
    },
    "/paymentSettingsHistory/{historyId}": {
      "schema": "PaymentSettingsHistory",
      "description": "Audit log of bKash receiver number changes"
    },
    "/usedTransactions/{trxId}": {
      "schema": "UsedTransaction",
      "description": "Duplicate bKash Transaction ID lock index"
    }
  }
}
