rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'realsafikul@gmail.com' ||
        (request.auth.uid != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validate User Profile
    function isValidUserProfile(data, userId) {
      return (data.userId == userId || data.uid == userId) &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('role' in data) || data.role in ['super_admin', 'approved_user', 'basic_user']) &&
        (!('status' in data) || data.status in ['active', 'pending']);
    }

    // Validate Design
    function isValidDesign(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 256 &&
        data.poster is map &&
        (!('thumb' in data) || (data.thumb is string && data.thumb.size() <= 500000));
    }

    // Validate Preset
    function isValidPreset(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 128 &&
        data.config is map &&
        (!('description' in data) || (data.description is string && data.description.size() <= 256)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64));
    }

    // Validate Brand Settings
    function isValidBrand(data, userId) {
      return data.userId == userId &&
        data.name is string && data.name.size() <= 128 &&
        data.handle is string && data.handle.size() <= 128 &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 256)) &&
        (!('logo' in data) || (data.logo is string && data.logo.size() <= 500000));
    }

    // Validate Favorites
    function isValidFavorites(data, userId) {
      return data.userId == userId &&
        data.quoteIds is list && data.quoteIds.size() <= 1000;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isSuperAdmin() || (
        isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        (!('role' in incoming()) || incoming().role == existing().role) &&
        (!('status' in incoming()) || incoming().status == existing().status)
      );
      allow delete: if isOwner(userId) || isSuperAdmin();

      // User Saved Designs subcollection
      match /designs/{designId} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(designId) && isValidDesign(incoming(), userId);
        allow update: if (isOwner(userId) || isSuperAdmin()) && isValidId(designId) && isValidDesign(incoming(), userId) &&
          incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Saved Presets subcollection
      match /presets/{presetId} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(presetId) && isValidPreset(incoming(), userId);
        allow update: if (isOwner(userId) || isSuperAdmin()) && isValidId(presetId) && isValidPreset(incoming(), userId) &&
          incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Brand Settings
      match /brand/{brandDoc} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidId(brandDoc) && isValidBrand(incoming(), userId);
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Favorites
      match /favorites/{favDoc} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidId(favDoc) && isValidFavorites(incoming(), userId);
        allow delete: if isOwner(userId) || isSuperAdmin();
      }
    }
  }
}
