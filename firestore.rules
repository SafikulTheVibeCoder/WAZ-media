rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strictly only the Super Admin / Owner (never ordinary admins, approved users, or basic users)
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'realsafikul@gmail.com' &&
         request.auth.token.email_verified == true) ||
        (request.auth.uid != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBdPhone(phone) {
      return phone is string && (phone == '0131198501' || phone.matches('^01[3-9][0-9]{8}$'));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validate User Profile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'userId', 'email', 'role', 'status']) &&
        data.keys().hasOnly([
          'uid', 'userId', 'email', 'displayName', 'photoURL',
          'role', 'status', 'plan', 'planExpiresAt',
          'todayPosterCount', 'lastPosterDate', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        data.userId == userId &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        data.role in ['super_admin', 'approved_user', 'basic_user', 'admin'] &&
        data.status in ['active', 'pending'] &&
        (!('plan' in data) || data.plan in ['free', 'pro', 'enterprise']) &&
        (!('planExpiresAt' in data) || (data.planExpiresAt is string && data.planExpiresAt.size() <= 64)) &&
        (!('todayPosterCount' in data) || (data.todayPosterCount is number && data.todayPosterCount >= 0 && data.todayPosterCount <= 100000)) &&
        (!('lastPosterDate' in data) || (data.lastPosterDate is string && data.lastPosterDate.size() <= 32)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validate Upgrade Request (create)
    function isValidUpgradeRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'userId', 'userEmail', 'targetPlan', 'amount',
          'senderPhone', 'transactionId', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'userName',
          'planId', 'planName', 'targetPlan', 'amount', 'currency', 'paymentMethod',
          'receiverNumberAtSubmission', 'senderNumber', 'senderPhone',
          'transactionId', 'screenshotUrl', 'status', 'createdAt', 'serverCreatedAt'
        ]) &&
        data.id == requestId &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userId == request.auth.uid &&
        data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 256 &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 128)) &&
        data.targetPlan in ['pro', 'enterprise'] &&
        (!('planId' in data) || data.planId == data.targetPlan) &&
        (!('planName' in data) || (data.planName is string && data.planName.size() <= 128)) &&
        (!('currency' in data) || data.currency == 'BDT') &&
        (!('paymentMethod' in data) || data.paymentMethod == 'bkash') &&
        data.amount is number &&
        ((data.targetPlan == 'pro' && data.amount == 199) ||
         (data.targetPlan == 'enterprise' && data.amount == 499)) &&
        data.senderPhone is string && data.senderPhone.matches('^01[3-9][0-9]{8}$') &&
        (!('senderNumber' in data) || data.senderNumber == data.senderPhone) &&
        (!('receiverNumberAtSubmission' in data) || isValidBdPhone(data.receiverNumberAtSubmission)) &&
        data.transactionId is string && data.transactionId.size() >= 4 && data.transactionId.size() <= 64 &&
        data.transactionId.matches('^[A-Z0-9_\\-]+$') &&
        (!('screenshotUrl' in data) || (data.screenshotUrl is string && data.screenshotUrl.size() <= 1048576)) &&
        data.status == 'pending' &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('serverCreatedAt' in data) || data.serverCreatedAt == request.time);
    }

    // Validate Payment Settings
    function isValidPaymentSettings(data) {
      return data.keys().hasAll(['bkashNumber', 'paymentEnabled', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['bkashNumber', 'paymentEnabled', 'updatedAt', 'updatedBy', 'serverUpdatedAt']) &&
        isValidBdPhone(data.bkashNumber) &&
        data.paymentEnabled is bool &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 256 &&
        (!('serverUpdatedAt' in data) || data.serverUpdatedAt == request.time);
    }

    // Validate Payment Settings Audit History Entry
    function isValidPaymentSettingsHistory(data, historyId) {
      return data.keys().hasAll([
          'id', 'previousNumber', 'newNumber', 'changedBy', 'changedByUid', 'changedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'previousNumber', 'newNumber', 'changedBy', 'changedByName',
          'changedByUid', 'changedAt', 'serverChangedAt'
        ]) &&
        data.id == historyId &&
        isValidBdPhone(data.previousNumber) &&
        data.newNumber is string && data.newNumber.matches('^01[3-9][0-9]{8}$') &&
        data.changedBy is string && data.changedBy.size() > 0 && data.changedBy.size() <= 256 &&
        (!('changedByName' in data) || (data.changedByName is string && data.changedByName.size() <= 128)) &&
        data.changedByUid == request.auth.uid &&
        data.changedAt is string && data.changedAt.size() <= 64 &&
        (!('serverChangedAt' in data) || data.serverChangedAt == request.time);
    }

    // Validate User Notification
    function isValidNotification(data, userId, notifId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title', 'message', 'read', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'type', 'title', 'message',
          'requestId', 'rejectionReason', 'read', 'createdAt'
        ]) &&
        data.id == notifId &&
        data.userId == userId &&
        data.type in ['payment_approved', 'payment_rejected', 'info'] &&
        data.title is string && data.title.size() <= 200 &&
        data.message is string && data.message.size() <= 600 &&
        (!('requestId' in data) || (data.requestId is string && data.requestId.size() <= 128)) &&
        (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500)) &&
        data.read is bool &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validate Design
    function isValidDesign(data, userId, designId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'poster']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'created', 'updated', 'updatedAt', 'poster', 'thumb']) &&
        data.userId == userId &&
        data.id == designId &&
        data.title is string && data.title.size() <= 256 &&
        data.poster is map &&
        (!('created' in data) || data.created is number) &&
        (!('updated' in data) || data.updated is number) &&
        (!('updatedAt' in data) || data.updatedAt is number) &&
        (!('thumb' in data) || (data.thumb is string && data.thumb.size() <= 500000));
    }

    // Validate Preset
    function isValidPreset(data, userId, presetId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'config']) &&
        data.keys().hasOnly([
          'id', 'userId', 'name', 'description', 'category',
          'createdAt', 'isBuiltIn', 'previewGradient', 'config'
        ]) &&
        data.userId == userId &&
        data.id == presetId &&
        data.name is string && data.name.size() <= 128 &&
        data.config is map &&
        (!('description' in data) || (data.description is string && data.description.size() <= 256)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('createdAt' in data) || data.createdAt is number) &&
        (!('isBuiltIn' in data) || data.isBuiltIn is bool) &&
        (!('previewGradient' in data) || (data.previewGradient is string && data.previewGradient.size() <= 256));
    }

    // Validate Brand Settings
    function isValidBrand(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'handle']) &&
        data.keys().hasOnly([
          'userId', 'name', 'tagline', 'handle', 'showLogo', 'showTag',
          'showHandle', 'logo', 'pos', 'logoSize', 'watermark', 'updatedAt'
        ]) &&
        data.userId == userId &&
        data.name is string && data.name.size() <= 128 &&
        data.handle is string && data.handle.size() <= 128 &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 256)) &&
        (!('logo' in data) || data.logo == null || (data.logo is string && data.logo.size() <= 500000)) &&
        (!('pos' in data) || (data.pos is string && data.pos.size() <= 32)) &&
        (!('logoSize' in data) || (data.logoSize is number && data.logoSize >= 16 && data.logoSize <= 512)) &&
        (!('showLogo' in data) || data.showLogo is bool) &&
        (!('showTag' in data) || data.showTag is bool) &&
        (!('showHandle' in data) || data.showHandle is bool) &&
        (!('watermark' in data) || data.watermark is bool) &&
        (!('updatedAt' in data) || data.updatedAt is number);
    }

    // Validate Favorites
    function isValidFavorites(data, userId) {
      return data.keys().hasAll(['userId', 'quoteIds']) &&
        data.keys().hasOnly(['userId', 'quoteIds', 'updatedAt']) &&
        data.userId == userId &&
        data.quoteIds is list && data.quoteIds.size() <= 1000 &&
        (data.quoteIds.size() == 0 || data.quoteIds[0] is string) &&
        (!('updatedAt' in data) || data.updatedAt is number);
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(userId) && isValidUserProfile(incoming(), userId) && (
        isSuperAdmin() || (
          isOwner(userId) &&
          incoming().role == 'basic_user' &&
          incoming().status == 'pending' &&
          (!('plan' in incoming()) || incoming().plan == 'free') &&
          !('planExpiresAt' in incoming()) &&
          (!('todayPosterCount' in incoming()) || incoming().todayPosterCount == 0) &&
          (request.auth.token.email == null || incoming().email == request.auth.token.email)
        )
      );
      allow update: if (isSuperAdmin() && isValidId(userId) && isValidUserProfile(incoming(), userId)) || (
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'todayPosterCount', 'lastPosterDate', 'updatedAt'
        ]) &&
        incoming().email == existing().email &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        (!('role' in existing()) ? incoming().role == 'basic_user' : incoming().role == existing().role) &&
        (!('status' in existing()) ? incoming().status == 'pending' : incoming().status == existing().status) &&
        (!('plan' in existing()) ? (!('plan' in incoming()) || incoming().plan == 'free') : incoming().plan == existing().plan) &&
        (!('planExpiresAt' in existing()) ? !('planExpiresAt' in incoming()) : incoming().planExpiresAt == existing().planExpiresAt) &&
        (!('todayPosterCount' in incoming()) ||
         !('todayPosterCount' in existing()) ||
         incoming().todayPosterCount >= existing().todayPosterCount ||
         incoming().lastPosterDate != existing().lastPosterDate)
      );
      allow delete: if isOwner(userId) || isSuperAdmin();

      // User Saved Designs subcollection
      match /designs/{designId} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(designId) && isValidDesign(incoming(), userId, designId);
        allow update: if (isOwner(userId) || isSuperAdmin()) && isValidId(designId) && isValidDesign(incoming(), userId, designId) &&
          incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Saved Presets subcollection
      match /presets/{presetId} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(presetId) && isValidPreset(incoming(), userId, presetId);
        allow update: if (isOwner(userId) || isSuperAdmin()) && isValidId(presetId) && isValidPreset(incoming(), userId, presetId) &&
          incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Brand Settings
      match /brand/{brandDoc} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidId(brandDoc) && isValidBrand(incoming(), userId);
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Favorites
      match /favorites/{favDoc} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && isValidId(favDoc) && isValidFavorites(incoming(), userId);
        allow delete: if isOwner(userId) || isSuperAdmin();
      }

      // User Payment & Account Notifications
      match /notifications/{notifId} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create: if isSuperAdmin() && isValidId(notifId) && isValidNotification(incoming(), userId, notifId);
        allow update: if (
          isOwner(userId) &&
          isValidId(notifId) &&
          isValidNotification(incoming(), userId, notifId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
          incoming().read is bool
        ) || isSuperAdmin();
        allow delete: if isOwner(userId) || isSuperAdmin();
      }
    }

    // Payment Settings (Readable for active checkout receiver number, writable ONLY by Super Admin / Owner)
    match /settings/paymentSettings {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidPaymentSettings(incoming());
      allow delete: if false;
    }

    // Payment Settings Audit History (Immutable, Super Admin / Owner only)
    match /paymentSettingsHistory/{historyId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin() && isValidId(historyId) && isValidPaymentSettingsHistory(incoming(), historyId);
      allow update, delete: if false;
    }

    // Atomic Duplicate Transaction ID Lock
    match /usedTransactions/{trxId} {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(trxId) &&
        trxId.size() >= 4 &&
        trxId.size() <= 64 &&
        trxId.matches('^[A-Z0-9_\\-]+$') &&
        !exists(/databases/$(database)/documents/usedTransactions/$(trxId)) &&
        incoming().keys().hasAll(['transactionId', 'userId', 'requestId', 'createdAt']) &&
        incoming().keys().hasOnly(['transactionId', 'userId', 'requestId', 'createdAt', 'serverCreatedAt']) &&
        incoming().transactionId == trxId &&
        incoming().userId == request.auth.uid &&
        isValidId(incoming().requestId) &&
        incoming().createdAt is string && incoming().createdAt.size() <= 64 &&
        (!('serverCreatedAt' in incoming()) || incoming().serverCreatedAt == request.time) &&
        getAfter(/databases/$(database)/documents/upgradeRequests/$(incoming().requestId)).data.transactionId == trxId;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Payment Upgrade Requests (bKash manual payments)
    match /upgradeRequests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        isValidUpgradeRequest(incoming(), requestId) &&
        (
          (!exists(/databases/$(database)/documents/settings/paymentSettings) &&
           (!('receiverNumberAtSubmission' in incoming()) || incoming().receiverNumberAtSubmission == '0131198501')) ||
          (exists(/databases/$(database)/documents/settings/paymentSettings) &&
           get(/databases/$(database)/documents/settings/paymentSettings).data.paymentEnabled == true &&
           (!('receiverNumberAtSubmission' in incoming()) || incoming().receiverNumberAtSubmission == get(/databases/$(database)/documents/settings/paymentSettings).data.bkashNumber))
        ) &&
        existsAfter(/databases/$(database)/documents/usedTransactions/$(incoming().transactionId));
      allow update: if isSuperAdmin() &&
        existing().status == 'pending' &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy', 'rejectionReason', 'serverReviewedAt'
        ]) &&
        incoming().userId == existing().userId &&
        incoming().id == existing().id &&
        incoming().targetPlan == existing().targetPlan &&
        incoming().amount == existing().amount &&
        incoming().transactionId == existing().transactionId &&
        incoming().senderPhone == existing().senderPhone &&
        incoming().createdAt == existing().createdAt &&
        incoming().status in ['approved', 'rejected'] &&
        (!('rejectionReason' in incoming()) || (incoming().rejectionReason is string && incoming().rejectionReason.size() <= 500)) &&
        (!('serverReviewedAt' in incoming()) || incoming().serverReviewedAt == request.time);
      allow delete: if isSuperAdmin();
    }
  }
}
